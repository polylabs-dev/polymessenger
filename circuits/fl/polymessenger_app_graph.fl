// ── polymsg_encrypt ── ML-KEM session establishment, AES-256-GCM ────────────

circuit polymsg_encrypt_module() -> ModuleNode
    lex polylabs/polymessenger  @status production  @precision B
    observe metrics: [module_init]  meters [compute_cycles]
{
    make_polymsg_module("polymsg_encrypt", AperturePartition::Backend as u8,
        SLATier::Premium as u8, ResourceBudget8D {
            execution: 300000, hash_ops: 8000, bandwidth: 60000,
            storage: 50000, observe_events: 10000, proofs: 200,
            consensus: 50, memory: 67108864,
        })
}

