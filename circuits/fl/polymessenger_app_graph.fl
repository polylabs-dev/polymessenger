// ═══════════════════════════════════════════════════════════════════════════════
// Graph Registration
// ═══════════════════════════════════════════════════════════════════════════════

/// Register all 11 PolyMessenger modules and their intra-graph REQUIRES
/// dependency edges into the provided CsrStorage graph.
circuit polymessenger_app_graph_register(
    graph: CsrStorage
) -> CsrStorage
    lex polylabs/polymessenger
    @status production
    @precision B
    @attested true
    invariant "capacity" { graph.num_nodes + POLYMSG_MODULE_COUNT as u32 <= 4096 }
    observe metrics: [registered_module_count, registered_edge_count]
    meters [compute_cycles, memory_bytes]
{
    // ── Add all 11 modules ──────────────────────────────────────────────────
    let (g, id_encrypt)          = module_graph_add_module(graph, polymsg_encrypt_module())
    let (g, id_ratchet)          = module_graph_add_module(g, polymsg_ratchet_module())
    let (g, id_relay)            = module_graph_add_module(g, polymsg_relay_module())
    let (g, id_classify)         = module_graph_add_module(g, polymsg_classify_module())
    let (g, id_incognito)        = module_graph_add_module(g, polymsg_incognito_module())
    let (g, id_metering)         = module_graph_add_module(g, polymsg_metering_module())
    let (g, id_platform_health)  = module_graph_add_module(g, polymsg_platform_health_module())
    let (g, id_rbac)             = module_graph_add_module(g, polymsg_rbac_module())
    let (g, id_contact_graph)    = module_graph_add_module(g, polymsg_contact_graph_module())
    let (g, id_conversation_dag) = module_graph_add_module(g, polymsg_conversation_dag_module())
    let (g, id_relay_graph)      = module_graph_add_module(g, polymsg_relay_graph_module())

    let vc = ">=" ++ POLYMSG_VERSION_STR

    // ── Intra-graph REQUIRES edges ──────────────────────────────────────────
    // encrypt -> ratchet (session key derivation)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polymsg_encrypt",
        source_version: POLYMSG_VERSION_STR, target_module: "polymsg_ratchet",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_encrypt, id_ratchet)

    // relay -> relay_graph (route selection)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polymsg_relay",
        source_version: POLYMSG_VERSION_STR, target_module: "polymsg_relay_graph",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_relay, id_relay_graph)

    // relay -> encrypt (onion layer encryption)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polymsg_relay",
        source_version: POLYMSG_VERSION_STR, target_module: "polymsg_encrypt",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_relay, id_encrypt)

    // classify -> rbac (content policy enforcement)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polymsg_classify",
        source_version: POLYMSG_VERSION_STR, target_module: "polymsg_rbac",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_classify, id_rbac)

    // incognito -> encrypt (ephemeral session establishment)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polymsg_incognito",
        source_version: POLYMSG_VERSION_STR, target_module: "polymsg_encrypt",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_incognito, id_encrypt)

    // contact_graph -> rbac (trust and blocking enforcement)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polymsg_contact_graph",
        source_version: POLYMSG_VERSION_STR, target_module: "polymsg_rbac",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_contact_graph, id_rbac)

    // conversation_dag -> encrypt (message ordering with encryption)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polymsg_conversation_dag",
        source_version: POLYMSG_VERSION_STR, target_module: "polymsg_encrypt",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_conversation_dag, id_encrypt)

    // metering -> relay (relay hop accounting)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polymsg_metering",
        source_version: POLYMSG_VERSION_STR, target_module: "polymsg_relay",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_metering, id_relay)

    // platform_health -> relay_graph (relay health overlay reads)
    let g = module_graph_add_edge(g, ModuleEdge {
        edge_type: EDGE_REQUIRES, source_module: "polymsg_platform_health",
        source_version: POLYMSG_VERSION_STR, target_module: "polymsg_relay_graph",
        target_version_constraint: vc, metadata: bytes(0),
    }, id_platform_health, id_relay_graph)

    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// Cross-Graph Bridge Edges — PolyKit
// ═══════════════════════════════════════════════════════════════════════════════

/// Register EDGE_BRIDGE_TO edges linking PolyMessenger's relay module to
/// PolyKit blind_relay and encrypt module to PolyKit media_stream.
circuit polymessenger_register_bridge_edges(
    graph: CsrStorage
) -> CsrStorage
    lex polylabs/polymessenger
    @status production
    @precision B
    @attested true
    observe metrics: [bridge_count]
    meters [compute_cycles]
{
    let relay_id = find_poly_module_id(graph, "polymsg_relay")
    let encrypt_id = find_poly_module_id(graph, "polymsg_encrypt")

    let g = graph

    // polymsg_relay -> PolyKit blind_relay bridge
    if relay_id != 0xFFFFFFFF as u32 {
        let relay_bridge = InterAppEdge {
            edge_type: EDGE_BRIDGE_TO,
            source_lex: POLYMSG_APP_LEX,
            source_module: "polymsg_relay",
            target_lex: "polylabs/polykit",
            target_module: "polykit_blind_relay",
            bridge_scope: BridgeScope::Platform as u8,
            shared_fields: ["relay_config", "route_policy", "cover_traffic_config"],
            redacted_fields: [],
            bilateral_confirmed: false,
        }
        g = module_graph_add_bridge_edge(g, relay_bridge, relay_id)
    }

    // polymsg_encrypt -> PolyKit media_stream bridge
    if encrypt_id != 0xFFFFFFFF as u32 {
        let media_bridge = InterAppEdge {
            edge_type: EDGE_BRIDGE_TO,
            source_lex: POLYMSG_APP_LEX,
            source_module: "polymsg_encrypt",
            target_lex: "polylabs/polykit",
            target_module: "polykit_media_stream",
            bridge_scope: BridgeScope::Platform as u8,
            shared_fields: ["stream_config", "codec_policy", "bandwidth_allocation"],
            redacted_fields: [],
            bilateral_confirmed: false,
        }
        g = module_graph_add_bridge_edge(g, media_bridge, encrypt_id)
    }

    g
}

// ═══════════════════════════════════════════════════════════════════════════════
// Internal Helpers
// ═══════════════════════════════════════════════════════════════════════════════

circuit find_polymsg_module_id(graph: CsrStorage, name: string) -> u32
    lex polylabs/polymessenger
    @status production
    @precision D
{
    find_poly_module_id(graph, name)
}

// ── Metrics Store ──────────────────────────────────────────────────────────────

store series polymsg_app_graph_metrics
    lex polylabs/polymessenger/metrics
{
    operation: string key
    product_name: string
    module_count: u32
    edge_count: u32
    bridge_count: u32
    register_latency_ns: u64
}

// ── Golden Tests ───────────────────────────────────────────────────────────────

test golden "polymsg_app_graph_registers_11_modules" {
    exec {
        let g = graph_create()
        let g = polymessenger_app_graph_register(g)
    }
    assert {
        g.num_nodes == 11
        g.num_edges == 9
        find_poly_module_id(g, "polymsg_encrypt") != 0xFFFFFFFF
        find_poly_module_id(g, "polymsg_ratchet") != 0xFFFFFFFF
        find_poly_module_id(g, "polymsg_relay") != 0xFFFFFFFF
        find_poly_module_id(g, "polymsg_classify") != 0xFFFFFFFF
        find_poly_module_id(g, "polymsg_incognito") != 0xFFFFFFFF
        find_poly_module_id(g, "polymsg_metering") != 0xFFFFFFFF
        find_poly_module_id(g, "polymsg_platform_health") != 0xFFFFFFFF
        find_poly_module_id(g, "polymsg_rbac") != 0xFFFFFFFF
        find_poly_module_id(g, "polymsg_contact_graph") != 0xFFFFFFFF
        find_poly_module_id(g, "polymsg_conversation_dag") != 0xFFFFFFFF
        find_poly_module_id(g, "polymsg_relay_graph") != 0xFFFFFFFF
    }
}

test golden "polymsg_bridge_edges_connect_polykit" {
    exec {
        let g = graph_create()
        let g = polymessenger_app_graph_register(g)
        let g = polymessenger_register_bridge_edges(g)
    }
    assert {
        g.num_nodes == 11 + 2
        let relay_id = find_poly_module_id(g, "polymsg_relay")
        relay_id != 0xFFFFFFFF
        let encrypt_id = find_poly_module_id(g, "polymsg_encrypt")
        encrypt_id != 0xFFFFFFFF
    }
}

test golden "make_polymsg_module_creates_valid_node" {
    let node = make_polymsg_module("polymsg_test",
        AperturePartition::Backend as u8,
        SLATier::Standard as u8,
        ResourceBudget8D {
            execution: 5000, hash_ops: 200, bandwidth: 2000,
            storage: 1000, observe_events: 100, proofs: 10,
            consensus: 5, memory: 4096,
        })
    assert node.name == "polymsg_test"
    assert node.version_major == POLYMSG_VERSION_MAJOR
    assert node.version_minor == POLYMSG_VERSION_MINOR
    assert node.resource_budget.execution == 5000
    assert node.state == ModuleState::Active as u8
    assert node.sla_tier == SLATier::Standard as u8
}

// ── Extern ─────────────────────────────────────────────────────────────────────

extern "rust" {
    #[module = "estream_runtime"]
    #[api = "graph"]
    #[state = "os"]
    fn graph_create() -> CsrStorage
}
